      },
      {
        "id": "step2",
        "type": "text",
        "settings": {
          "heading": "2. Try your first …",
          "body": "Describe the quick win — the moment people see why they signed up.",
          "featured": "off"
        }
      },
      {
        "id": "button",
        "type": "button",
        "settings": {
          "text": "Open my account",
          "url": "https://example.com",
          "featured": "off"
        }
      },
      {
        "id": "help",
        "type": "columns",
        "settings": {
          "leftTitle": "Need a hand?",
          "leftBody": "Reply to this email — a real person will answer.",
          "rightTitle": "Guides",
          "rightBody": "Short how-tos for everything, in one place.",
          "featured": "on"
        }
      },
      {
        "id": "footer",
        "type": "footer",
        "settings": {
          "note": "You're receiving this because you've just opened an account with us.",
          "featured": "on"
