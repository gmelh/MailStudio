        "id": "hero",
        "type": "hero",
        "settings": {
          "eyebrow": "You're all set",
          "title": "Let's get you started",
          "description": "A short welcome, then straight to the useful part. New customers want to get going.",
          "featured": "off"
        }
      },
      {
        "id": "steps",
        "type": "contents",
        "settings": {
          "title": "Three steps",
          "items": "Set up your account — it takes two minutes\nTry the one feature everyone loves first\nInvite a friend or teammate",
