        "heading": "Arial, Helvetica, sans-serif",
        "body": "Arial, Helvetica, sans-serif",
        "small": "Arial, Helvetica, sans-serif"
      },
      "button": {
        "bold": true,
        "italic": false
      },
      "flatFeatured": false,
      "light": {
        "outer": "#efe4dc",
        "background": "#fffdfb",
        "featured": "#f6e5dd",
        "text": "#54443d",
        "heading": "#2a1912",
        "link": "#a8442a",
        "accent": "#a8442a",
        "buttonText": "#ffffff"
      },
      "dark": {
        "outer": "#140d0a",
        "background": "#1e1511",
        "featured": "#38231b",
        "text": "#e6d6ce",
