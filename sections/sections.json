        {
          "key": "align",
          "label": "Text alignment",
          "kind": "select",
          "options": [
            [
              "center",
              "Centred"
            ],
            [
              "left",
              "Left"
            ]
          ]
        },
        {
          "key": "height",
          "label": "Height",
          "kind": "select",
          "options": [
            [
              "short",
              "Short"
            ],
            [
              "medium",
              "Medium"
            ],
            [
              "tall",
              "Tall"
            ]
          ]
        },
        {
          "key": "edge",
          "label": "Image to the edges",
          "kind": "toggle",
          "hint": "Fills the full width of the email, with no space or rounded corners around it."
        },
        {
          "key": "featured",
          "label": "Feature background",
          "kind": "toggle"
        }
      ],
      "defaults": {
        "url": "",
        "title": "Made fresh, every morning",
        "text": "Come and see what's new this week.",
        "buttonText": "See what's new",
        "buttonUrl": "https://example.com",
        "tone": "light",
        "align": "center",
        "height": "medium",
        "edge": "on",
        "featured": "off"
      }
    },
    "text": {
      "label": "Text",
      "icon": "☰",
      "fields": [
        {
          "key": "heading",
          "label": "Heading",
          "kind": "text"
        },
        {
          "key": "body",
          "label": "Body text",
          "kind": "textarea"
        },
        {
          "key": "featured",
          "label": "Feature background",
          "kind": "toggle"
