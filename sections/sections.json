{
  "$comment": "Section types shared by the server renderer and the editor. Each type has templates/<type>.mjml (MJML with Mustache placeholders). Field kinds: text, textarea, url, image, number, select, toggle (\"on\" or \"off\").",
  "version": 1,
  "sections": {
    "header": {
      "label": "Header",
      "icon": "▤",
      "fields": [
        {
          "key": "brand",
          "label": "Brand name",
          "kind": "text"
        },
        {
          "key": "tagline",
          "label": "Tagline",
          "kind": "text"
        },
        {
          "key": "imageUrl",
          "label": "Logo image",
          "kind": "image",
          "fallback": "brand.logo"
        },
        {
          "key": "imageAlt",
          "label": "Image description",
          "kind": "text",
          "hint": "Leave empty to use the brand name. It's shown when images are blocked and read out by screen readers."
        },
        {
          "key": "imageLink",
          "label": "Image link (optional)",
          "kind": "url",
          "hint": "Where the logo goes when clicked, usually your website. Leave empty for no link."
        },
        {
          "key": "imageWidth",
          "label": "Image width (px)",
          "kind": "number",
          "min": 40,
          "max": 600,
          "hideWhen": {
            "imageStretch": "on"
          }
        },
        {
          "key": "imagePosition",
          "label": "Image placement",
          "kind": "select",
          "options": [
            [
              "above",
              "Above the name"
            ],
            [
              "beside",
              "Beside the name"
            ],
            [
              "below",
              "Below the name"
            ]
          ],
          "hideWhen": {
            "imageStretch": "on"
          }
        },
        {
          "key": "imageStretch",
          "label": "Stretch to edges",
          "kind": "toggle",
          "needs": "imageUrl",
          "hint": "The image fills the whole header, edge to edge, with no space around it. The brand name and tagline show only when there's no image."
        },
        {
          "key": "featured",
          "label": "Feature background",
          "kind": "toggle"
        }
      ],
      "defaults": {
        "brand": "YOUR COMPANY",
        "tagline": "",
        "imageUrl": "",
        "imageAlt": "",
        "imageWidth": "240",
        "imagePosition": "above",
        "imageStretch": "off",
        "featured": "off",
        "imageLink": ""
      }
    },
    "hero": {
      "label": "Feature",
      "icon": "▣",
      "fields": [
        {
          "key": "eyebrow",
          "label": "Small heading",
          "kind": "text"
        },
        {
          "key": "title",
          "label": "Headline",
          "kind": "text"
        },
        {
          "key": "description",
          "label": "Description",
          "kind": "textarea"
        },
        {
          "key": "featured",
          "label": "Feature background",
          "kind": "toggle"
        }
      ],
      "defaults": {
        "eyebrow": "A FRESH UPDATE",
        "title": "Something new is here.",
        "description": "Beautiful emails, without the complicated tools.",
        "featured": "on"
      }
    },
    "heroImage": {
      "label": "Hero image",
      "icon": "▨",
      "fields": [
        {
          "key": "url",
          "label": "Background image",
          "kind": "image",
          "hint": "A wide photo works best (at least 1200px wide). Keep the important part in the middle: the edges may be cropped on phones."
        },
        {
          "key": "title",
          "label": "Headline",
          "kind": "text"
        },
        {
          "key": "text",
          "label": "Text",
          "kind": "textarea"
        },
        {
          "key": "buttonText",
          "label": "Button label",
          "kind": "text"
        },
        {
          "key": "buttonUrl",
          "label": "Button link",
          "kind": "url",
          "hint": "Leave empty for no button."
        },
        {
          "key": "tone",
          "label": "Text colour",
          "kind": "select",
          "options": [
            [
              "light",
              "White text (for darker photos)"
            ],
            [
              "dark",
              "Dark text (for lighter photos)"
            ]
          ]
