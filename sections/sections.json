          "label": "Image to the edges",
          "kind": "toggle",
          "needs": "url",
          "hint": "Pushes the image to the email's edges, with no space around it. It keeps its shape and isn't stretched."
        },
        {
          "key": "featured",
          "label": "Feature background",
          "kind": "toggle"
        }
      ],
      "defaults": {
        "url": "",
        "alt": "",
        "featured": "off",
        "link": "",
        "edge": "off"
      }
    },
    "button": {
      "label": "Button",
