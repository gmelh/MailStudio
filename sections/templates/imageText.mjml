<mj-section css-class="ms-s-{{section_id}} ms-featured" background-color="{{brand.featured}}">
  {{^s.position_is_right}}
  <mj-column width="50%" vertical-align="middle">
    {{#s.url_ok}}<mj-image src="{{s.url}}" alt="{{s.alt}}" border-radius="6px" padding="0 24px 16px 0" />{{/s.url_ok}}
  </mj-column>
  <mj-column width="50%" vertical-align="middle">
    <mj-text css-class="ms-text"><h3 class="ms-heading" style="{{brand.h3}}">{{s.title}}</h3>{{{s.body_html}}}</mj-text>
  </mj-column>
  {{/s.position_is_right}}
  {{#s.position_is_right}}
  <mj-column width="50%" vertical-align="middle">
    <mj-text css-class="ms-text" padding="0 24px 16px 0"><h3 class="ms-heading" style="{{brand.h3}}">{{s.title}}</h3>{{{s.body_html}}}</mj-text>
  </mj-column>
  <mj-column width="50%" vertical-align="middle">
    {{#s.url_ok}}<mj-image src="{{s.url}}" alt="{{s.alt}}" border-radius="6px" />{{/s.url_ok}}
  </mj-column>
  {{/s.position_is_right}}
</mj-section>
