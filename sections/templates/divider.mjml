<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}} padding="10px {{brand.padding}}px">
  <mj-column>
    <mj-divider css-class="ms-divider" border-width="1px" border-color="{{brand.divider}}" padding="0" />
  </mj-column>
</mj-section>
