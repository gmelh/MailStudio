<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}} padding="22px {{brand.padding}}px">
  <mj-column>
    <mj-text css-class="ms-muted" align="center" font-family="{{brand.fonts.small}}" font-size="13px" line-height="1.9" color="{{brand.muted}}">{{s.message}}<br><a class="ms-link" href="{{merge.unsubscribe_url}}" style="color:{{brand.link}}">Unsubscribe</a></mj-text>
  </mj-column>
</mj-section>
