<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}} padding="22px {{brand.padding}}px">
  <mj-column>
    {{#s.title}}<mj-text css-class="ms-text" align="center" font-family="{{brand.fonts.small}}" font-size="13px" padding="0 0 12px"><strong>{{s.title}}</strong></mj-text>{{/s.title}}
    <mj-social mode="horizontal" align="center" icon-size="{{s.size}}px" border-radius="0" padding="0" inner-padding="0 6px">
    {{#s.website_ok}}<mj-social-element src="{{site}}/social/website-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.website}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.website}}" alt="Website" title="Website" background-color="transparent" />{{/s.website_ok}}
    {{#s.instagram_ok}}<mj-social-element src="{{site}}/social/instagram-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.instagram}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.instagram}}" alt="Instagram" title="Instagram" background-color="transparent" />{{/s.instagram_ok}}
    {{#s.facebook_ok}}<mj-social-element src="{{site}}/social/facebook-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.facebook}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.facebook}}" alt="Facebook" title="Facebook" background-color="transparent" />{{/s.facebook_ok}}
    {{#s.linkedin_ok}}<mj-social-element src="{{site}}/social/linkedin-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.linkedin}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.linkedin}}" alt="LinkedIn" title="LinkedIn" background-color="transparent" />{{/s.linkedin_ok}}
    {{#s.x_ok}}<mj-social-element src="{{site}}/social/x-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.x}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.x}}" alt="X" title="X" background-color="transparent" />{{/s.x_ok}}
    {{#s.youtube_ok}}<mj-social-element src="{{site}}/social/youtube-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.youtube}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.youtube}}" alt="YouTube" title="YouTube" background-color="transparent" />{{/s.youtube_ok}}
    {{#s.tiktok_ok}}<mj-social-element src="{{site}}/social/tiktok-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.tiktok}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.tiktok}}" alt="TikTok" title="TikTok" background-color="transparent" />{{/s.tiktok_ok}}
    {{#s.pinterest_ok}}<mj-social-element src="{{site}}/social/pinterest-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.pinterest}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.pinterest}}" alt="Pinterest" title="Pinterest" background-color="transparent" />{{/s.pinterest_ok}}
    {{#s.threads_ok}}<mj-social-element src="{{site}}/social/threads-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.threads}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.threads}}" alt="Threads" title="Threads" background-color="transparent" />{{/s.threads_ok}}
    {{#s.bluesky_ok}}<mj-social-element src="{{site}}/social/bluesky-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.bluesky}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.bluesky}}" alt="Bluesky" title="Bluesky" background-color="transparent" />{{/s.bluesky_ok}}
    {{#s.whatsapp_ok}}<mj-social-element src="{{site}}/social/whatsapp-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.whatsapp}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.whatsapp}}" alt="WhatsApp" title="WhatsApp" background-color="transparent" />{{/s.whatsapp_ok}}
    {{#s.mastodon_ok}}<mj-social-element src="{{site}}/social/mastodon-{{s.style}}-{{#nohash}}{{#s.colour_is_network}}{{social.mastodon}}{{/s.colour_is_network}}{{#s.colour_is_accent}}{{brand.accent}}{{/s.colour_is_accent}}{{#s.colour_is_heading}}{{brand.heading}}{{/s.colour_is_heading}}{{#s.colour_is_custom}}{{s.customColour}}{{/s.colour_is_custom}}{{/nohash}}.png" href="{{s.mastodon}}" alt="Mastodon" title="Mastodon" background-color="transparent" />{{/s.mastodon_ok}}
    </mj-social>
  </mj-column>
</mj-section>
