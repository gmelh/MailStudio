<mj-section css-class="ms-s-{{section_id}} ms-featured" background-color="{{brand.featured}}" padding="48px {{brand.padding}}px 44px">
  <mj-column>
    <mj-text css-class="ms-text" align="center" font-family="{{brand.fonts.small}}" font-size="11px" font-weight="800" letter-spacing="2px"><span style="text-transform:uppercase">{{s.eyebrow}}</span></mj-text>
    <mj-text css-class="ms-text" align="center" padding-top="12px"><h2 class="ms-heading" style="{{brand.h2}}">{{s.title}}</h2>{{{s.description_html}}}</mj-text>
  </mj-column>
</mj-section>
