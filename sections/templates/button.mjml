{{#s.url_ok}}
<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}} padding="12px {{brand.padding}}px 28px">
  <mj-column>
    <mj-button css-class="ms-button" href="{{s.url}}">{{s.text}}</mj-button>
  </mj-column>
</mj-section>
{{/s.url_ok}}
