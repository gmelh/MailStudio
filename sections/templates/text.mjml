<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}}>
  <mj-column>
    <mj-text css-class="ms-text">{{#s.heading}}<h3 class="ms-heading" style="{{brand.h3}}">{{s.heading}}</h3>{{/s.heading}}{{{s.body_html}}}</mj-text>
  </mj-column>
</mj-section>
