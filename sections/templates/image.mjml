{{#s.url_ok}}
<mj-section css-class="ms-s-{{section_id}}{{#s.featured_on}} ms-featured{{/s.featured_on}}"{{#s.featured_on}} background-color="{{brand.featured}}"{{/s.featured_on}} padding="{{#s.edge_on}}0{{/s.edge_on}}{{^s.edge_on}}20px {{brand.padding}}px{{/s.edge_on}}">
  <mj-column>
    <mj-image{{#s.link_ok}} href="{{s.link}}"{{/s.link_ok}} src="{{s.url}}" alt="{{s.alt}}"{{^s.edge_on}} border-radius="5px"{{/s.edge_on}} />
  </mj-column>
</mj-section>
{{/s.url_ok}}
